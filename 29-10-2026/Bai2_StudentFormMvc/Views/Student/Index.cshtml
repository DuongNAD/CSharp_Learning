@model IEnumerable<Bai2_StudentFormMvc.Models.Student>

@{
    ViewData["Title"] = "Danh Sách Sinh Viên Đã Nhập";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="mb-0 text-success fw-bold">Danh Sách Sinh Viên Đã Nhập</h4>
        <a asp-action="Create" class="btn btn-success btn-sm">+ Thêm Sinh Viên Mới</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Id</th>
                        <th>Họ và Tên</th>
                        <th>Tuổi</th>
                        <th>Lớp</th>
                        <th>Email</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#@item.Id</td>
                            <td>@item.Name</td>
                            <td>@item.Age</td>
                            <td><span class="badge bg-secondary">@item.ClassName</span></td>
                            <td>@item.Email</td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
