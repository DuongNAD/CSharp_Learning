@model Ticket
@{
    ViewData["Title"] = "Xóa vé";
}

<h2 class="mb-3 text-danger">Xóa vé</h2>
<div class="alert alert-warning">Bạn có chắc chắn muốn xóa vé này?</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Phim</dt>
            <dd class="col-sm-9">@Model.Movie?.Title</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ShowDate)</dt>
            <dd class="col-sm-9">@Model.ShowDate.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CustomerName)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.CustomerName)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CustomerPhone)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.CustomerPhone)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.SeatQuantity)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.SeatQuantity)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a class="btn btn-secondary" asp-action="Index">Hủy</a>
</form>
