@model IEnumerable<Ticket>
@{
    ViewData["Title"] = "Danh sách vé";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Danh sách vé</h2>
    <a class="btn btn-primary" asp-action="Create">+ Đặt vé</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle bg-white">
        <thead class="table-dark">
            <tr>
                <th>Phim</th>
                <th>@Html.DisplayNameFor(m => m.ShowDate)</th>
                <th>@Html.DisplayNameFor(m => m.CustomerName)</th>
                <th>@Html.DisplayNameFor(m => m.CustomerPhone)</th>
                <th>@Html.DisplayNameFor(m => m.SeatQuantity)</th>
                <th>Tổng tiền</th>
                <th style="width: 170px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Movie?.Title</td>
                <td>@item.ShowDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@Html.DisplayFor(m => item.CustomerName)</td>
                <td>@Html.DisplayFor(m => item.CustomerPhone)</td>
                <td>@Html.DisplayFor(m => item.SeatQuantity)</td>
                <td>@((item.SeatQuantity * (item.Movie?.BasePrice ?? 0)).ToString("N0"))</td>
                <td>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted py-4">Chưa có vé nào.</td></tr>
        }
        </tbody>
    </table>
</div>
