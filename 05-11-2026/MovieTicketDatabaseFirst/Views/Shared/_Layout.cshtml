<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phim &amp; Vé</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Movies" asp-action="Index">Quản Lý Phim &amp; Vé (Database First)</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link text-white" asp-controller="Movies" asp-action="Index">Phim</a>
                <a class="nav-link text-white" asp-controller="Tickets" asp-action="Index">Vé</a>
                <a class="nav-link text-warning fw-semibold" asp-controller="Tickets" asp-action="Create">+ Đặt vé</a>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-center text-muted bg-white">
        <small>&copy; 2026 - Aptech AAHN_C2411L - MVC Database First 1</small>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
