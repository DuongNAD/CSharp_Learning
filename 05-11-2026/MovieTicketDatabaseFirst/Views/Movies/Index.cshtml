@model IEnumerable<Movie>
@{
    ViewData["Title"] = "Danh sách phim";
}

<h2 class="mb-3">Danh sách phim</h2>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle bg-white">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(m => m.Title)</th>
                <th>@Html.DisplayNameFor(m => m.BasePrice)</th>
                <th>@Html.DisplayNameFor(m => m.DurationMinutes)</th>
                <th>@Html.DisplayNameFor(m => m.Genre)</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(m => item.Title)</td>
                <td>@Html.DisplayFor(m => item.BasePrice)</td>
                <td>@Html.DisplayFor(m => item.DurationMinutes)</td>
                <td>@Html.DisplayFor(m => item.Genre)</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-center text-muted py-4">Chưa có phim nào.</td></tr>
        }
        </tbody>
    </table>
</div>
