@model BorrowingRecord
@{
    ViewData["Title"] = "Xóa phiếu mượn";
}

<h2 class="mb-3 text-danger">Xóa phiếu mượn</h2>
<div class="alert alert-warning">Bạn có chắc chắn muốn xóa phiếu mượn này?</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Sách</dt>
            <dd class="col-sm-9">@Model.Book?.Title</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.BorrowerName)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.BorrowerName)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.BorrowerEmail)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.BorrowerEmail)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.BorrowDate)</dt>
            <dd class="col-sm-9">@Model.BorrowDate.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ReturnDate)</dt>
            <dd class="col-sm-9">@(Model.ReturnDate?.ToString("dd/MM/yyyy") ?? "Chưa trả")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a class="btn btn-secondary" asp-action="Index">Hủy</a>
</form>
