@model MvcHttpDemo.Models.Student

@{
    ViewData["Title"] = "Sửa Thông Tin Sinh Viên";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning bg-opacity-25 py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold text-dark">Chỉnh Sửa Thông Tin Sinh Viên</h4>
                <span class="badge bg-dark">Mã SV: #@Model.Id</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <!-- Giữ nguyên Id của sinh viên cần sửa -->
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Id" class="form-label fw-semibold"></label>
                        <input value="#@Model.Id" class="form-control bg-light" disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Age" class="form-label fw-semibold"></label>
                            <input asp-for="Age" type="number" class="form-control" />
                            <span asp-validation-for="Age" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Major" class="form-label fw-semibold"></label>
                            <input asp-for="Major" class="form-control" />
                            <span asp-validation-for="Major" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy &amp; Quay lại</a>
                        <button type="submit" class="btn btn-warning fw-semibold px-4">Cập Nhật Sinh Viên</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
