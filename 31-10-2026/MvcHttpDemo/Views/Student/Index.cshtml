@model IEnumerable<MvcHttpDemo.Models.Student>

@{
    ViewData["Title"] = "Quản Lý Sinh Viên";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success shadow-sm">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <div class="row align-items-center g-2">
            <div class="col-md-5">
                <h4 class="mb-0 fw-bold text-dark">Danh Sách Sinh Viên</h4>
            </div>
            <div class="col-md-7">
                <form asp-action="Index" method="get" class="d-flex gap-2 justify-content-md-end">
                    <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control form-control-sm w-auto" placeholder="Tìm theo tên, email, ngành..." />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Tìm kiếm</button>
                    <a asp-action="Create" class="btn btn-sm btn-primary">+ Thêm Mới</a>
                </form>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Mã SV</th>
                        <th>Họ và Tên</th>
                        <th>Tuổi</th>
                        <th>Email</th>
                        <th>Chuyên ngành</th>
                        <th class="text-end pe-4">Hành động (CRUD)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#@student.Id</td>
                            <td class="fw-semibold">@student.Name</td>
                            <td>@student.Age</td>
                            <td>@student.Email</td>
                            <td><span class="badge bg-info text-dark">@student.Major</span></td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-outline-info">Chi tiết</a>
                                <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-warning fw-semibold">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
