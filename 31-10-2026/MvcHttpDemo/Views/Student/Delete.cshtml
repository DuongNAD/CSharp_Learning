@model MvcHttpDemo.Models.Student

@{
    ViewData["Title"] = "Xóa Sinh Viên";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0 fw-bold">Xác Nhận Xóa Sinh Viên</h4>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">Bạn có chắc chắn muốn xóa sinh viên này khỏi danh sách không?</p>
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Mã SV:</dt>
                    <dd class="col-sm-8 fw-bold">#@Model.Id</dd>

                    <dt class="col-sm-4 text-muted">Họ và Tên:</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4 text-muted">Email:</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                </dl>
            </div>
            <div class="card-footer bg-white py-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger px-4">Xác Nhận Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>
