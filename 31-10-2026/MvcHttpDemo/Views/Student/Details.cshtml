@model MvcHttpDemo.Models.Student

@{
    ViewData["Title"] = "Chi Tiết Sinh Viên";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold text-info">Thông Tin Chi Tiết Sinh Viên</h4>
                <span class="badge bg-dark">Mã SV: #@Model.Id</span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 fs-6">
                    <dt class="col-sm-4 text-muted">Mã sinh viên:</dt>
                    <dd class="col-sm-8 fw-bold">#@Model.Id</dd>

                    <dt class="col-sm-4 text-muted">Họ và Tên:</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                    <dt class="col-sm-4 text-muted">Tuổi:</dt>
                    <dd class="col-sm-8">@Model.Age tuổi</dd>

                    <dt class="col-sm-4 text-muted">Email:</dt>
                    <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                    <dt class="col-sm-4 text-muted">Chuyên ngành:</dt>
                    <dd class="col-sm-8"><span class="badge bg-info text-dark">@Model.Major</span></dd>
                </dl>
            </div>
            <div class="card-footer bg-white py-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-semibold">Sửa Thông Tin</a>
            </div>
        </div>
    </div>
</div>
