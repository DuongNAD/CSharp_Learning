@model Student
@{
    ViewData["Title"] = "Sửa thông tin sinh viên";
}

<h2 class="mb-3">Sửa thông tin sinh viên</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.StudentId" method="post">
            <input type="hidden" asp-for="StudentId" />
            <partial name="_StudentFields" model="Model" />
            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
