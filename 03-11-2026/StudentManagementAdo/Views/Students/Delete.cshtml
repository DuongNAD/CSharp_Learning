@model Student
@{
    ViewData["Title"] = "Xóa sinh viên";
}

<h2 class="mb-3 text-danger">Xóa sinh viên</h2>
<div class="alert alert-warning">Bạn có chắc chắn muốn xóa sinh viên này? Thao tác không thể hoàn tác.</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.StudentCode)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.StudentCode)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FullName)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.FullName)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DateOfBirth)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.DateOfBirth)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Email)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Phone)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Phone)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.StudentId" method="post">
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a class="btn btn-secondary" asp-action="Index">Hủy</a>
</form>
